# =============================================
# KING WhatsApp Bot - Configuration Render
# Développé par Kervens - kervens-king/KING
# Session Pair - Optimisé pour Render
# =============================================

# 🌍 ENVIRONNEMENT
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
TIMEZONE=Africa/Porto-Novo

# 👤 PROPRIÉTAIRE DU BOT
OWNER_NUMBER=+50937277651
OWNER_NAME=Kervens
BOT_NAME=KING
AUTHOR=Kervens
PREFIX=.
WORKTYPE=public

# 🔧 CONFIGURATION BOT & SESSION
SESSION_ID=king_session_pair
SESSION_TYPE=pair
READ_MESSAGE=true
STATUS_VIEW=false
LIKE_STATUS=false
STARTUP_MSG=true
ALWAYS_ONLINE=false

# 🛡️ SÉCURITÉ
ANTILINK=false
ANTI_EDIT=false
ANTI_EDIT_IN_CHAT=false
REJECT_CALL=true
SAVE_STATUS=false
CMD_REACT=true

# 📊 PERFORMANCE OPTIMISÉE RENDER
MAX_FILE_SIZE=100
MAX_UPLOAD_SIZE=50
MAX_VIDEO_SIZE=80
MAX_IMAGE_SIZE=15
MAX_AUDIO_SIZE=10
MAX_DOCUMENT_SIZE=30

# 🎯 OPTIMISATION MÉDIAS
AUTO_COMPRESS_MEDIA=true
COMPRESSION_THRESHOLD=5
COMPRESSION_QUALITY=75
ENABLE_MEDIA_CACHE=true
MAX_CACHE_SIZE=200
CLEANUP_INTERVAL=3600

# 🌐 SERVICES EXTERNES
MEGA_EMAIL=romeochefbratva200k@gmail.com
MEGA_PASSWORD=UMP-MP5-MP40
USE_MEGA_FOR_LARGE_FILES=true
MEGA_FILE_THRESHOLD=20

# 🔗 RENDER (AUTOMATIQUE)
RENDER_API_KEY=${RENDER_API_KEY}
RENDER_SERVICE_ID=${RENDER_SERVICE_ID}

# 📍 MÉTADONNÉES
GITHUB=kervens-king/KING
VERSION=1.0.0
LANG_CODE=fr
